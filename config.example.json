{
  "provider": {
    "type": "auto",
    "hook_cmd": ""
  },
  "cloudflare": {
    "api_token": "YOUR_CLOUDFLARE_API_TOKEN_HERE",
    "zone_name": "example.com",
    "record_name": "vps.example.com"
  },
  "oci": {
    "auth_method": "config_file",
    "config_path": "/root/.oci/config"
  },
  "monitor": {
    "interval_sec": 15,
    "loss_threshold": 75.0,
    "consecutive_failures": 3,
    "auto_heal_enabled": false,
    "auto_heal_mode": "notify_only",
    "reip_cooldown_hours": 24,
    "max_reip_per_day": 2,
    "last_reip_timestamp": 0,
    "inbound_probe_url": "",
    "inbound_probe_token": ""
  },
  "notifications": {
    "enabled": false,
    "telegram": {
      "enabled": false,
      "bot_token": "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ",
      "chat_id": "987654321",
      "bot_enabled": false,
      "admin_user_ids": []
    },
    "discord": {
      "enabled": false,
      "webhook_url": "https://discord.com/api/webhooks/..."
    },
    "bark": {
      "enabled": false,
      "bark_key": "YOUR_BARK_DEVICE_KEY"
    },
    "custom_webhook": {
      "enabled": false,
      "url": "https://api.example.com/webhook"
    }
  },
  "rules_config": {
    "adblock": true,
    "ai_group": true,
    "media_group": true,
    "auto_test": true,
    "direct_cn": true,
    "hy2_hop": false
  },
  "security": {
    "auth_enabled": true,
    "admin_username": "admin",
    "secret_path": "/sentinel",
    "enable_host_guard": true,
    "allowed_hosts": [
      "vps.example.com"
    ],
    "trusted_proxy_cidrs": []
  },
  "transits": [
    {
      "id": "transit_example_01",
      "name": "国内联通优化中转 (示例)",
      "host": "relay.example.com",
      "hy2_port": 20443,
      "reality_port": 28443,
      "trojan_port": 22083,
      "enabled": false
    }
  ],
  "network": {
    "allowed_private_hosts": [],
    "ca_bundle": ""
  },
  "proxy_sources": [
    {
      "type": "sqlite",
      "enabled": true
    }
  ],
  "hetzner": {
    "external_controller": false
  },
  "cert_sync": {
    "enabled": false,
    "role": "disabled",
    "master_url": "",
    "sync_token": "",
    "cert_dir": "",
    "verify_ssl": true,
    "expected_domains": [],
    "poll_interval_hours": 12,
    "auto_reload_services": [
      "x-ui"
    ],
    "post_sync_hook": ""
  }
}
